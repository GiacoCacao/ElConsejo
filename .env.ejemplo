# IA: endpoint compatible con OpenAI (el mismo que usan whatsapp y el orquestador).
CONSEJO_IA_URL=https://api.deepseek.com/v1
CONSEJO_IA_MODELO=deepseek-chat
# Es una credencial: va solo aquí, nunca en un chat ni en un .md.
CONSEJO_IA_CLAVE=

# Fábrica de documentos (extrae texto/OCR de los PDF y busca por significado). Va por la IP de
# Tailscale porque está en otra red de Docker. Sin esto no se pueden subir documentos.
CONSEJO_FABRICA_URL=http://IP-DE-LA-FABRICA:8060
# CONSEJO_FABRICA_CLAVE=
