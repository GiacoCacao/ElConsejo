# IA: endpoint compatible con OpenAI (el mismo que usan whatsapp y el orquestador).
CONSEJO_IA_URL=https://api.deepseek.com/v1
CONSEJO_IA_MODELO=deepseek-flash
# 1 = deja que DeepSeek razone antes de responder (más lento y caro). Por defecto, no.
# CONSEJO_IA_PENSAR=0
# Es una credencial: va solo aquí, nunca en un chat ni en un .md.
CONSEJO_IA_CLAVE=

# Fábrica de documentos (extrae texto/OCR de los PDF y busca por significado). Va por la IP de
# Tailscale porque está en otra red de Docker. Sin esto no se pueden subir documentos.
CONSEJO_FABRICA_URL=http://IP-DE-LA-FABRICA:8060
# CONSEJO_FABRICA_CLAVE=

# --- Acceso a la sala ------------------------------------------------------
# Sin CONSEJO_CLAVE_PRESIDENCIA la sala queda abierta a toda la red.
# CONSEJO_SECRETO firma la cookie de sesión:  python3 -c "import secrets;print(secrets.token_hex(32))"
CONSEJO_SECRETO=
CONSEJO_CLAVE_PRESIDENCIA=
# Opcional: clave de solo lectura (ve sesiones, actas y consumo; no consulta ni modifica)
# CONSEJO_CLAVE_OBSERVADOR=
# Copias de seguridad diarias que se conservan en datos/copias
# CONSEJO_COPIAS=14
